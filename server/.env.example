# ─── Server ────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Aiven for MySQL) ───────────
DB_URL=mysql://avnadmin:<PASSWORD>@<HOST>:<PORT>/brightloop?ssl-mode=REQUIRED
DB_SSL_CA_PATH=./certs/ca.pem
# DB_SSL_CA=                        # paste PEM contents for deploys
DB_POOL_MAX=8

# ─── Authentication ───────────────────────
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
RESET_TTL_MINUTES=30

# ─── Mail ─────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Brightloop <no-reply@brightloop.test>"

# ─── URLs ─────────────────────────────────
PORTAL_URL=http://localhost:5173
OPS_URL=http://localhost:5174

# ─── Billing ─────────────────────────────
BILLING_CRON=0 1 * * *
BILLING_AUTO_CONFIRM=true

# ─── Seed ─────────────────────────────────
SEED_ADMIN_EMAIL=admin@brightloop.test
SEED_ADMIN_PASSWORD=Admin@12345

